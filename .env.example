# Liquid AI model from Hugging Face, run locally with MLX on Apple Silicon (downloads on first run)
LIQUID_MODEL_ID=LiquidAI/LFM2.5-2.6B-MLX-8bit
LIQUID_MAX_NEW_TOKENS=1800

NIMBLE_API_KEY=
NIMBLE_CLI_BIN=nimble

RAWTREE_API_KEY=
RAWTREE_BASE_URL=https://api.rawtree.com

GITHUB_TOKEN=
GITHUB_REPO=

MAX_ACTIVE_FACTS=12
MAX_ACTIVE_CHANGES=8
MAX_HYPOTHESES=5
MAX_OPEN_QUESTIONS=5
VERIFY_EVERY=3
MAX_RECENT_QUESTIONS=8
MAX_IMPACTED_FILES=10
DEVTRACE_DATA_DIR=.devtrace
